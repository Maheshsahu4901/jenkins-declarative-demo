pipeline {
    agent any

    environment {
        PATH = "/usr/bin:$PATH"
    }

    stages {

        stage("Git Checkout") {
            steps {
                git branch: 'main', url: 'https://github.com/Maheshsahu4901/jenkins-declarative-demo.git'
            }
        }

        stage("Maven Build") {
            steps {
                sh "mvn clean package"
                sh "mv target/*.war target/myweb.war"
            }
        }
        stage("Deploy-dev"){
            sshagent(credentials: ['tomcat-new'], executable: '') {
                sh """
                    scp -o StrictHostKeyChecking=no target/myweb.war ubuntu@172.31.36.194:/tmp/tomcat9/webapps/

                    ssh ubuntu@172.31.36.194 /tmp/tomcat9/bin/shutdown.sh    

                    ssh ubuntu@172.31.36.194 /tmp/tomcat9/bin/startup.sh
                """
            }
          
        }
    }
}
