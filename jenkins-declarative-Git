pipeline{
    agent any
    environment{
        PATH = "/usr/bin:$PATH"
    }
    stages{
        stage("Git Checkout"){
            steps{
                git branch: 'main', url: 'https://github.com/Maheshsahu4901/jenkins-declarative-demo.git'
            }
        }
        stage("Maven build"){
            steps{
                sh "mvn clean package"
            }
        }
    }
}
